# ==============================================================================
# KONFIGURASI SUPABASE DEV (JANGAN PERNAH MEMAKAI KUNCI PRODUKSI SAAT DEVELOPMENT)
# Salin file ini menjadi .env.local lalu isi dengan kredensial project Supabase dev
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_DEV_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_DEV_SUPABASE_ANON_KEY"

# RAHASIA SERVER: Hanya dipakai di sisi server (src/lib/supabase/admin.ts).
# Jangan pernah diekspos ke browser atau di-commit ke git.
SUPABASE_SERVICE_ROLE_KEY="YOUR_DEV_SUPABASE_SERVICE_ROLE_KEY"

# Opsional: Zona waktu aplikasi (default Asia/Jakarta)
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jakarta"

